{
  "name": "dynkle",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "terminal": "npm run start -w @dynkle/terminal",
    "web": "npm run web -w @dynkle/terminal",
    "test": "npm test -w @dynkle/shared -w @dynkle/terminal",
    "typecheck": "npm run typecheck -w @dynkle/shared -w @dynkle/terminal",
    "lint": "eslint . && npm run lint -w @dynkle/terminal",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
