{
  "name": "@dynkle/mock-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node --enable-source-maps dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node22 --sourcemap --outfile=dist/index.js --external:fastify --external:@fastify/cors --external:@fastify/websocket",
    "start:ts": "tsx src/index.ts"
  },
  "dependencies": {
    "@dynkle/shared": "*",
    "@fastify/cors": "^11.0.1",
    "@fastify/websocket": "^11.1.0",
    "fastify": "^5.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.20.3",
    "typescript": "~6.0.3",
    "vitest": "^3.2.4",
    "ws": "^8.18.2"
  }
}
